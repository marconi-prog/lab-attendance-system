# Backend — execução local (fora do Docker). Copie para backend/.env.
FLASK_APP=app:create_app
FLASK_ENV=development

# MySQL 8 (o docker compose expõe o banco em localhost:3306)
DATABASE_URL=mysql+pymysql://atendimento:SUA_SENHA@127.0.0.1:3306/atendimento?charset=utf8mb4
# Banco exclusivo dos testes automatizados (é LIMPO a cada teste!)
TEST_DATABASE_URL=mysql+pymysql://atendimento:SUA_SENHA@127.0.0.1:3306/atendimento_test?charset=utf8mb4

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Origens do frontend autorizadas (CORS + Socket.IO)
CORS_ORIGINS=http://localhost:8081,http://localhost:8080

APP_TIMEZONE=America/Recife
BUSINESS_OPEN_TIME=07:00
BUSINESS_CLOSE_TIME=17:00
TICKET_ISSUE_OPEN_TIME=06:00
# false permite demonstrar o sistema fora do horário comercial
ENFORCE_BUSINESS_HOURS=true

LAB_NAME="Laboratório de Análises Clínicas"
LOG_LEVEL=INFO
