# Variáveis usadas pelo docker-compose.yml. Copie para ".env" e altere os valores.
# NUNCA versione o arquivo .env.

MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=atendimento
MYSQL_USER=atendimento
MYSQL_PASSWORD=troque-esta-senha
MYSQL_PORT=3306

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=gere-um-segredo-longo-e-aleatorio
SECRET_KEY=gere-outro-segredo-longo-e-aleatorio

BACKEND_PORT=5000
FRONTEND_PORT=8080

# Origens autorizadas (CORS e Socket.IO), separadas por vírgula
CORS_ORIGINS=http://localhost:8080,http://localhost:8081

# URL pública da API vista pelo navegador (embutida no build web do frontend)
PUBLIC_API_URL=http://localhost:5000

# true = bloqueia chamadas fora do expediente (07h–17h, America/Recife)
ENFORCE_BUSINESS_HOURS=true

LAB_NAME="Laboratório de Análises Clínicas"
